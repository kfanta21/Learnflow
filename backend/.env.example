# Copy this file to .env and fill in real values.
# Active Spring profile (dev or prod)
SPRING_PROFILES_ACTIVE=dev

# ── Database (Phase 1) ──────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/learnflow_dev
DB_USERNAME=learnflow
DB_PASSWORD=learnflow

# ── JWT (Phase 3) ────────────────────────────────────────────
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_ACCESS_TOKEN_EXPIRY_MS=900000
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# ── Google OAuth (Phase 3) ───────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Redis (Phase 5) ──────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Kafka (Phase 7) ──────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── AWS (Phase 6 + 10) ───────────────────────────────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=learnflow-content
AWS_CLOUDFRONT_DOMAIN=content.learnflow.ethiocentral.com

# ── Frontend (Phase 13) ──────────────────────────────────────
FRONTEND_URL=https://learnflow.ethiocentral.com